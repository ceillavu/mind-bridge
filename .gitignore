# ==========================================
# MindBridge — .gitignore
# ==========================================

# Environment & Private Config Files
.env
.env.local
.env.*.local

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp

# Editor & IDE Directories
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# Node & Build Artifacts (In case local tools or packages are added)
node_modules/
dist/
build/
.cache/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
